# Copy to .env on the server and fill in real values. Never commit the real .env.

# Postgres password for Keycloak's own database. Pick a strong random value.
KEYCLOAK_DB_PASSWORD=

# The domain this Keycloak instance serves at -- every app's Keycloak client config
# (KEYCLOAK_BASE_URL / KEYCLOAK_ISSUER env vars in Mail and Meet) must point at this same domain.
KEYCLOAK_HOSTNAME=account.toowix.com

# Bootstrap admin account used to log into /admin the first time. Change this (or rotate it)
# after you've set up a real admin user -- it stays valid for the life of this container.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Host port Keycloak is published on (behind the reverse proxy). 8080 matches the existing dev
# setup; only change this if something else on the server already uses it.
PORT_KEYCLOAK=8080
