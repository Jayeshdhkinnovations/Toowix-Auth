<#-- Toowix presentation only: Keycloak continues to own form actions, errors and credentials. -->
<#import "social-providers.ftl" as identityProviders>
<!doctype html>
<html lang="${lang}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sign in to Toowix</title><link rel="icon" type="image/svg+xml" href="${url.resourcesPath}/img/brand-mark.svg"><#list properties.styles?split(' ') as style><link href="${url.resourcesPath}/${style}" rel="stylesheet"></#list></head>
<body class="toowix-page"><main class="toowix-shell">
<section class="toowix-story" aria-label="Toowix"><img class="toowix-mark" src="${url.resourcesPath}/img/brand-mark.svg" alt="Toowix"><div class="toowix-story-copy"><h1>Welcome to<br>a more connected<br><span>Toowix</span></h1><p>Secure access for our team,<br>to build what&apos;s next.</p></div><div class="toowix-waves" aria-hidden="true"></div><p class="toowix-values">PEOPLE&nbsp;&nbsp;&bull;&nbsp;&nbsp; IDEAS&nbsp;&nbsp;&bull;&nbsp;&nbsp; IMPACT</p></section>
<section class="toowix-login" aria-labelledby="kc-page-title"><div class="toowix-login-content"><header><h2 id="kc-page-title">Sign in to Toowix</h2><p>Use your company account to continue</p></header>
<#if message?has_content><div class="toowix-message ${message.type!}" role="alert">${kcSanitize(message.summary)?no_esc}</div></#if>
<#if realm.password><form id="kc-form-login" action="${url.loginAction}" method="post" novalidate><label for="username">Email or company username</label><div class="toowix-input-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5h17v13h-17zM4 6l8 6 8-6"/></svg><input id="username" name="username" value="${login.username!''}" type="text" autocomplete="username" autofocus placeholder="you@toowix.com"></div><a class="toowix-forgot" href="${url.loginResetCredentialsUrl}">Forgot password?</a><div id="toowix-password-row" class="toowix-password-row" hidden><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password"><#if realm.rememberMe><label class="toowix-remember"><input name="rememberMe" type="checkbox" <#if login.rememberMe??>checked</#if>> Remember me</label></#if></div><input type="hidden" name="credentialId" <#if auth.selectedCredential?has_content>value="${auth.selectedCredential}"</#if>><button id="toowix-next" type="submit">Next <span aria-hidden="true">&rarr;</span></button></form></#if>
<#if social.providers?? && social.providers?has_content><div class="toowix-social"><@identityProviders.show social=social/></div></#if>
<footer class="toowix-footer"><p>Only authorized Toowix company accounts<br>can access this service.</p><nav aria-label="Support links"><a href="#">Help</a><i></i><a href="#">Privacy</a><i></i><a href="#">Terms</a></nav></footer></div></section></main>
<script>(()=>{const f=document.getElementById('kc-form-login'),r=document.getElementById('toowix-password-row'),p=document.getElementById('password'),b=document.getElementById('toowix-next');if(!f||!r||!p||!b)return;f.addEventListener('submit',e=>{if(r.hidden){e.preventDefault();r.hidden=false;p.required=true;p.focus();b.innerHTML='Sign in <span aria-hidden="true">&rarr;</span>';}})})();</script></body></html>
