<!doctype html>
<html lang="${lang}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Enter password | Toowix</title><link rel="icon" type="image/svg+xml" href="${url.resourcesPath}/img/brand-mark.svg"><#list properties.styles?split(' ') as style><link href="${url.resourcesPath}/${style}" rel="stylesheet"></#list></head>
<body class="toowix-page"><main class="toowix-shell">
<section class="toowix-story" aria-label="Toowix"><img class="toowix-mark" src="${url.resourcesPath}/img/brand-mark.svg" alt="Toowix"><div class="toowix-story-copy"><h1>Welcome<br>back to<br><span>Toowix</span></h1><p>Enter your password<br>to continue securely.</p></div><div class="toowix-waves" aria-hidden="true"></div><p class="toowix-values">PEOPLE&nbsp;&nbsp;&bull;&nbsp;&nbsp; IDEAS&nbsp;&nbsp;&bull;&nbsp;&nbsp; IMPACT</p></section>
<section class="toowix-login" aria-labelledby="kc-page-title"><div class="toowix-login-content"><header><h2 id="kc-page-title">Enter your password</h2><p>Welcome back. Sign in to continue.</p></header>
<#if message?has_content><div class="toowix-message ${message.type!}" role="alert">${kcSanitize(message.summary)?no_esc}</div></#if>
<form id="kc-form-login" action="${url.loginAction}" method="post"><label for="password">Password</label><input id="password" class="toowix-plain-input" name="password" type="password" autocomplete="current-password" autofocus required placeholder="Enter your password"><a class="toowix-forgot" href="${url.loginResetCredentialsUrl}">Forgot password?</a><button id="toowix-next" type="submit">Sign in <span aria-hidden="true">&rarr;</span></button></form>
<footer class="toowix-footer"><p>Only authorized Toowix company accounts<br>can access this service.</p><nav aria-label="Support links"><a href="#">Help</a><i></i><a href="#">Privacy</a><i></i><a href="#">Terms</a></nav></footer></div></section></main></body></html>
